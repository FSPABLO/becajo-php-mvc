# Redirige la raíz del proyecto hacia /public.
#
# Esto permite copiar la carpeta completa dentro de www/ o htdocs/ y que
# funcione, sin tener que configurar un VirtualHost. En un servidor real lo
# correcto es apuntar el DocumentRoot directamente a /public y borrar este
# archivo.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes

# Los archivos .env llevan credenciales (la clave de la API de Lembas). La regla
# de arriba ya los manda a public/, donde no existen, pero solo si mod_rewrite
# está activo: en un WAMP sin él, /.env se serviría como texto plano. Este
# bloqueo no depende de ningún módulo opcional.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
